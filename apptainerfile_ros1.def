# Apptainer definition for the Unveiler inference stack on ROS 1 Noetic.
#
# Purpose
# -------
# All lab computers now run ROS 2.  This container provides a self-contained
# ROS 1 Noetic environment so that the heavy inference work (SRE + ActionDecoder)
# can run on a lab machine (with GPU) while the Dofbot Pro Jetson only runs
# the lightweight robot-driver packages.
#
# The container acts as the ROS master.  The Jetson connects to it by setting
#   ROS_MASTER_URI=http://<lab_machine_ip>:11311
# on boot.
#
# Build
# -----
#   apptainer build apptainerfile_ros1.sif apptainerfile_ros1.def
#
# Run (example)
# -------------
#   apptainer shell --nv --bind /path/to/object-unveiler:/workspace apptainerfile_ros1.sif
#   # then inside the container:
#   bash /workspace/run_inference_container.sh

Bootstrap: docker
# Ubuntu 20.04 is the official OS for ROS 1 Noetic.
# Use CUDA 11.8 so that the lab GPU can accelerate inference.
From: nvidia/cuda:11.8.0-runtime-ubuntu20.04

# ── Environment ──────────────────────────────────────────────────────────────
%environment
    # Python
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1

    # ROS 1 Noetic
    source /opt/ros/noetic/setup.bash
    export ROS_DISTRO=noetic

    # Workspace — adjust the bind-mount path if it differs
    export UNVEILER_WS=/workspace

# ── Build steps ──────────────────────────────────────────────────────────────
%post
    export DEBIAN_FRONTEND=noninteractive
    export TZ=UTC

    # ── System base ──────────────────────────────────────────────────────────
    apt-get update && apt-get install -y --no-install-recommends \
        curl \
        gnupg2 \
        lsb-release \
        git \
        wget \
        build-essential \
        python3-pip \
        python3-dev \
        python3-opencv \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        iputils-ping \
        net-tools \
        iproute2 \
        && rm -rf /var/lib/apt/lists/*

    # ── ROS 1 Noetic ─────────────────────────────────────────────────────────
    sh -c 'echo "deb http://packages.ros.org/ros/ubuntu $(lsb_release -sc) main" \
        > /etc/apt/sources.list.d/ros-latest.list'
    curl -sSL 'http://keyserver.ubuntu.com/pks/lookup?op=get&search=0xC1CF6E31E6BADE8868B172B4F42ED6FBAB17C654' \
        | apt-key add -

    apt-get update && apt-get install -y --no-install-recommends \
        ros-noetic-ros-base \
        ros-noetic-cv-bridge \
        ros-noetic-image-transport \
        ros-noetic-sensor-msgs \
        ros-noetic-geometry-msgs \
        ros-noetic-std-msgs \
        ros-noetic-rospy \
        python3-rosdep \
        python3-rosinstall \
        python3-rosinstall-generator \
        python3-wstool \
        && rm -rf /var/lib/apt/lists/*

    rosdep init || true
    rosdep update

    # ── Python inference dependencies ─────────────────────────────────────────
    python3 -m pip install --upgrade pip
    python3 -m pip install --no-cache-dir \
        numpy==1.26.3 \
        opencv-python \
        torch==2.1.2+cu118 \
        torchvision==0.16.2+cu118 \
        --extra-index-url https://download.pytorch.org/whl/cu118

    python3 -m pip install --no-cache-dir \
        pybullet \
        open3d \
        matplotlib \
        tabulate \
        imutils \
        pycocotools \
        termcolor \
        Pillow \
        scikit-image \
        tensorboard \
        pyquaternion==0.9.9 \
        pyyaml==6.0 \
        pexpect==4.8.0 \
        einops \
        packaging \
        h5py \
        scipy \
        tenacity

    # ── Source ROS in every shell ─────────────────────────────────────────────
    echo "source /opt/ros/noetic/setup.bash" >> /etc/bash.bashrc

%labels
    Author  object-unveiler
    Version 1.0
    ROSDistro noetic
    CUDABase  11.8

%help
    Self-contained ROS 1 Noetic + CUDA 11.8 container for Unveiler inference.

    Usage:
        # Build
        apptainer build apptainerfile_ros1.sif apptainerfile_ros1.def

        # Launch inference node (see run_inference_container.sh)
        apptainer exec --nv \
            --bind /path/to/object-unveiler:/workspace \
            apptainerfile_ros1.sif \
            bash /workspace/run_inference_container.sh

        # Interactive shell
        apptainer shell --nv \
            --bind /path/to/object-unveiler:/workspace \
            apptainerfile_ros1.sif
